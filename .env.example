# ─────────────────────────────────────────────────────────────────────────────
# Vellum Resume Studio — environment template
#
# Docker Compose reads `.env` (not `.env.local`):
#   cp .env.example .env
#   # edit APP_URL, S3_PUBLIC_ENDPOINT, and GROQ_API_KEY, then:
#   docker compose up -d --build
#
# Running without Docker (`npm run dev`)? Copy to `.env.local` and use
# `localhost` for DATABASE_URL / S3_ENDPOINT. Never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public URL ───────────────────────────────────────────────────────────────
# The URL users open in the browser. On EC2 use the instance's public IPv4
# address (or Elastic IP / DNS name) and port 3000.
APP_URL=http://<EC2-PUBLIC-IP>:3000

# Internal URL the headless PDF renderer navigates to. In Docker this is the
# app container itself, so the request never leaves the host or hits the EC2
# security group.
PDF_BASE_URL=http://127.0.0.1:3000

# The runtime image already sets NODE_ENV=production; keep it explicit here so
# scripts and `docker compose config` agree.
NODE_ENV=production

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Compose starts a local `db` service, so the host is `db`. For RDS/managed
# PostgreSQL, replace this with the managed connection string and set
# DATABASE_SSL=true.
DATABASE_URL=postgresql://vellum:vellum@db:5432/vellum
DATABASE_SSL=false
# Accept self-signed certificates only if your provider requires it.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5

# Credentials for the Compose `db` service. If you change these, update
# DATABASE_URL to match (URL-encode special characters).
POSTGRES_USER=vellum
POSTGRES_PASSWORD=vellum
POSTGRES_DB=vellum

# ── Sessions ─────────────────────────────────────────────────────────────────
# Anonymous, HTTP-only workspace cookie. Change if multiple apps share a domain.
SESSION_COOKIE_NAME=vellum_session

# ── Groq AI ──────────────────────────────────────────────────────────────────
# Server-only key from Groq Console (https://console.groq.com/keys).
# Without it the editor still works; AI actions return AI_NOT_CONFIGURED.
GROQ_API_KEY=your_groq_api_key_here
# This account/key must have access to the chosen model. GPT-OSS 20B works with
# Groq JSON Object Mode and is the default.
GROQ_MODEL=openai/gpt-oss-20b

# ── S3-compatible object storage ─────────────────────────────────────────────
# Compose runs S3Mock on port 9090. For durable storage use real AWS S3, R2,
# MinIO, Backblaze B2, or GCS interoperability and change these values.
S3_BUCKET=vellum-exports
S3_REGION=us-east-1
# Internal endpoint used by the app container.
S3_ENDPOINT=http://s3mock:9090
# Browser-facing endpoint used when signing download URLs. On EC2 this must be
# the public address, otherwise signed links point at the user's own machine.
S3_PUBLIC_ENDPOINT=http://<EC2-PUBLIC-IP>:9090
# S3Mock accepts any non-empty pair. AWS/R2 use real credentials; omit both to
# use an IAM instance role instead.
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
# S3Mock, MinIO, and some gateways require path-style addressing.
S3_FORCE_PATH_STYLE=true
# Optional SSE. Set to AES256 for SSE-S3; omit for SSE-KMS.
# S3_SERVER_SIDE_ENCRYPTION=AES256

# ── Local development storage ────────────────────────────────────────────────
# Signs dev-only download URLs when S3_BUCKET is unset. Not used in production.
STORAGE_SIGNING_SECRET=replace-with-a-long-random-string

# ── PDF rendering ────────────────────────────────────────────────────────────
# The Docker image installs Chromium and sets CHROME_EXECUTABLE_PATH itself.
# Local Chrome/Chromium is auto-detected on common paths; override if needed.
# CHROME_EXECUTABLE_PATH=/usr/bin/chromium
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# USE_SPARTICUZ_CHROMIUM=false
