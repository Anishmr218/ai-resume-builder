# ─────────────────────────────────────────────────────────────────────────────
# Vellum Resume Studio — environment template
# Copy to .env.local for development. Never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# Public origin used for print/PDF navigation and download links.
# Set this to the deployed HTTPS origin in production.
APP_URL=http://localhost:3000

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Required in production. If omitted in development, Vellum uses an in-memory
# demo store that resets whenever the dev server restarts.
DATABASE_URL=postgresql://vellum:vellum@localhost:5432/vellum
# Enable for managed providers that require TLS (RDS, Cloud SQL, Neon, Supabase).
DATABASE_SSL=false
# Accept self-signed certificates only if your provider requires it.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5

# ── Sessions ─────────────────────────────────────────────────────────────────
# Anonymous, HTTP-only workspace cookie. Change if you run multiple apps on one
# domain and need isolated cookies.
SESSION_COOKIE_NAME=vellum_session

# ── Groq AI ──────────────────────────────────────────────────────────────────
# Server-only key from Groq Console (https://console.groq.com/keys).
# Without it, the editor still works; AI actions return AI_NOT_CONFIGURED.
GROQ_API_KEY=your_groq_api_key_here
# Optional model override. The service defaults to OpenAI GPT-OSS 20B.
# GROQ_MODEL=openai/gpt-oss-20b

# ── S3-compatible object storage ─────────────────────────────────────────────
# Required in production for avatars + archived PDF exports. Works with AWS S3,
# Cloudflare R2, MinIO, Backblaze B2, and GCS through its S3 interoperability
# endpoint. Leave credentials blank when using an IAM role / workload identity.
S3_BUCKET=
S3_REGION=us-east-1
# Custom endpoint for non-AWS providers and local emulators.
# Docker compose's S3Mock uses http://localhost:9090 (http://s3mock:9090
# from inside the app container).
# S3_ENDPOINT=http://localhost:9090
# Browser-facing endpoint used only when signing download URLs. Useful when the
# app talks to object storage over an internal Docker network but the browser
# needs localhost. Defaults to S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=http://localhost:9090
# S3Mock accepts any non-empty key pair; AWS/R2 use real credentials.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3Mock, MinIO, and some gateways require path-style addressing.
S3_FORCE_PATH_STYLE=false
# Optional SSE. Set to AES256 for SSE-S3; omit for SSE-KMS (configure the key in
# the bucket policy or use a custom endpoint that handles encryption).
# S3_SERVER_SIDE_ENCRYPTION=AES256

# ── Local development storage ────────────────────────────────────────────────
# Signs dev-only download URLs when S3_BUCKET is unset. Not used in production.
STORAGE_SIGNING_SECRET=replace-with-a-long-random-string

# ── PDF rendering ────────────────────────────────────────────────────────────
# Server-side PDF export uses headless Chromium via puppeteer-core.
# Local Chrome/Chromium is auto-detected on common paths. Set explicitly if
# yours lives elsewhere. On Vercel/AWS Lambda, @sparticuz/chromium is used
# automatically (or force it with USE_SPARTICUZ_CHROMIUM=true).
# CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# USE_SPARTICUZ_CHROMIUM=false
